# Required
GEMINI_API_KEY=

# Optional: read AI answers aloud (speaker icon on each answer)
ELEVENLABS_API_KEY=

# Optional: answers that contain your money figures are written by a local model instead of Gemini.
# Same machine: http://localhost:11434. Other machine: run scripts/host_ollama.py there and paste its two lines.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Optional: the LiteRT switch runs a model inside the backend (no server needed).
# Get the model once with: uv run --directory backend python ../scripts/get_litert_model.py
# LITERT_MODEL_PATH=models/litert/gemma-4-E2B-it.litertlm
# LITERT_BACKEND=cpu

# Optional: everything below shows its default; uncomment to override.
# GEMINI_MODEL=gemini-3.6-flash
# JWT_SECRET=dev-secret-change-me
# DEMO_MODE=true
# DEMO_TODAY=2026-09-15
# DB_PATH=db/money_coach.sqlite3
# COACH_ORIGIN=http://localhost:5173
# DEMO_ORIGIN=http://localhost:8081
# OLLAMA_MODEL=gemma4:e4b
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
