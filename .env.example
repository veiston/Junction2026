# Required
GEMINI_API_KEY=

# Optional: read AI answers aloud (speaker icon on each answer)
ELEVENLABS_API_KEY=

# Optional: answers that contain your money figures are written by a local model instead of Gemini.
# Same machine: http://localhost:11434. Other machine: run scripts/host_ollama.py there and paste its two lines.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Optional: everything below shows its default; uncomment to override.
# GEMINI_MODEL=gemini-3.6-flash
# JWT_SECRET=dev-secret-change-me
# DEMO_MODE=true
# DEMO_TODAY=2026-09-15
# DB_PATH=db/money_coach.sqlite3
