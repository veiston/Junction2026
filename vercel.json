{
  "services": {
    "backend": {
      "root": "backend",
      "entrypoint": "main:app"
    },
    "frontend": {
      "root": "frontend",
      "buildCommand": "EXPO_PUBLIC_API_BASE_URL=/api/v1 pnpm exec expo export --platform web",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
