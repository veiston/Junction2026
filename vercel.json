{
  "services": {
    "frontend": {
      "root": "frontend",
      "buildCommand": "EXPO_PUBLIC_API_BASE_URL=https://junction2026-production.up.railway.app/api/v1 pnpm exec expo export --platform web",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
